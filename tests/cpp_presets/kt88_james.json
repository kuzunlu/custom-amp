{
  "name": "Test: James tone circuit and a KT88 pair",
  "notes": "Not an amp: only for tools/cpp_check.py (C++ against Python), to cover the james style and the KT88.",
  "chain": [
    { "type": "gain", "id": "v1", "curve": "triode", "plate_volts": true },
    { "type": "tonestack", "id": "tone", "style": "james", "treble": 7, "bass": 3 },
    { "type": "eq", "level_db": -12 },
    {
      "type": "feedback", "id": "nfb", "amount": 0.05,
      "path": [ { "kind": "highshelf", "freq": 3000, "gain_db": -6 } ],
      "chain": [
        { "type": "gain", "id": "pi", "curve": "triode", "plate_volts": true, "drive_db": -6 },
        { "type": "power", "id": "pa", "tube": "KT88", "plate_v": 560, "bias_v": -66, "raa_ohms": 4500 }
      ]
    }
  ]
}
