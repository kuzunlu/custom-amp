{
  "name": "American hot-rod lead (SLO-style)",
  "notes": "Late-80s American hot-rod lead style: thick, singing, mid-rich high gain with a smooth top. Like the modern high gain preset in layout but with more mids, bigger coupling caps (less bass cut between stages), and a 6L6-family power amp with presence and depth (resonance) in the feedback loop. FROM SCHEMATICS (fairly sure): cascaded 12AX7 stages with a cold clipper, cathode follower, passive tone stack after the preamp, 6L6-family power tubes, presence and depth controls in the feedback loop. UNSURE / APPROXIMATED: all cathode and bias values, the bright cap, the high-passes between stages (80 and 120 Hz), tone stack values (british-style values with a 47k slope resistor and 250k treble pot), four power tubes modelled as a pair, feedback amount (set for about 6 dB), depth as a -6 dB low shelf at 100 Hz in the feedback path. Phase inverter as one triode that gets half the input (each triode of the real long-tailed pair sees half the signal, so it has twice the headroom of a single stage).",
  "panel": [
    { "label": "Gain", "block": "gain_pot", "setting": "level_db", "range": [-40, 0] },
    { "label": "Bass", "block": "tone", "setting": "bass" },
    { "label": "Middle", "block": "tone", "setting": "mid" },
    { "label": "Treble", "block": "tone", "setting": "treble" },
    { "label": "Presence", "block": "nfb", "setting": "path.0.gain_db", "range": [0, -12] },
    { "label": "Resonance", "block": "nfb", "setting": "path.1.gain_db", "range": [0, -12] },
    { "label": "Master", "block": "master", "setting": "level_db", "range": [-40, 0] }
  ],
  "chain": [
    { "type": "gate", "threshold_db": -55, "hysteresis_db": 3, "hold_ms": 50, "release_ms": 100, "apply_after": "v2b" },
    { "type": "gain", "id": "v1a", "curve": "triode", "tube": "12AX7", "plate_v": 280, "plate_ohms": 100e3, "bias_v": -1.5, "plate_volts": true },
    { "type": "eq", "id": "gain_pot", "level_db": -10, "bands": [ { "kind": "highshelf", "freq": 1200, "gain_db": 4 } ] },
    { "type": "gain", "id": "v1b", "curve": "triode", "tube": "12AX7", "plate_v": 280, "plate_ohms": 100e3, "bias_v": -1.5, "plate_volts": true,
      "pre": [ { "kind": "highpass", "freq": 80 } ], "bias_shift": 0.4, "shift_release_ms": 40 },
    { "type": "eq", "id": "divider1", "level_db": -12, "bands": [ { "kind": "peak", "freq": 700, "gain_db": 3, "q": 0.7 } ] },
    { "type": "gain", "id": "v2a_cold", "curve": "triode", "tube": "12AX7", "plate_v": 280, "plate_ohms": 100e3, "bias_v": -2.8, "plate_volts": true,
      "pre": [ { "kind": "highpass", "freq": 120 } ], "bias_shift": 0.5, "shift_release_ms": 40 },
    { "type": "eq", "id": "divider2", "level_db": -12 },
    { "type": "gain", "id": "v2b", "curve": "triode", "tube": "12AX7", "plate_v": 280, "plate_ohms": 100e3, "bias_v": -1.5, "plate_volts": true,
      "post": [ { "kind": "lowpass", "freq": 5500 } ] },
    { "type": "gain", "id": "cathode_follower", "curve": "custom", "top": 40, "top_softness": 0.3, "bottom": 200, "bottom_softness": 0.5 },
    { "type": "tonestack", "id": "tone", "style": "british", "parts": { "R4": 47e3, "R1": 250e3 }, "treble": 5, "mid": 7, "bass": 5 },
    { "type": "eq", "id": "master", "level_db": -20 },
    { "type": "sag", "amount": 0.2, "attack_ms": 5, "release_ms": 150, "targets": ["pa"] },
    {
      "type": "feedback", "id": "nfb", "amount": 0.03,
      "path": [ { "kind": "highshelf", "freq": 3000, "gain_db": -6 }, { "kind": "lowshelf", "freq": 100, "gain_db": -6 } ],
      "chain": [
        { "type": "gain", "id": "pi", "curve": "triode", "tube": "12AX7", "plate_v": 330, "plate_ohms": 82e3, "bias_v": -1.5, "plate_volts": true, "drive_db": -6 },
        { "type": "power", "id": "pa", "tube": "6L6GC", "plate_v": 460, "bias_v": -47, "raa_ohms": 4200,
          "pre": [ { "kind": "highpass", "freq": 20 } ],
          "post": [ { "kind": "highpass", "freq": 60 }, { "kind": "lowpass", "freq": 7500 } ],
          "bias_shift": 0.4, "shift_release_ms": 20 }
