{
  "name": "High gain",
  "notes": "Tight modern high gain. A mid boost and bass cut before the gain, three preamp stages with more bass cut before each one (so the low end stays tight), scooped tone stack, little sag, and a power amp loop with presence and resonance.",
  "chain": [
    {
      "type": "eq", "id": "tight",
      "bands": [{ "kind": "highpass", "freq": 100 }, { "kind": "peak", "freq": 800, "gain_db": 4, "q": 0.8 }]
    },
    {
      "type": "gain", "id": "v1", "drive_db": 24, "curve": "tube", "bias": 0.1,
      "pre": [{ "kind": "highpass", "freq": 120 }],
      "post": [{ "kind": "lowpass", "freq": 8000 }]
    },
    {
      "type": "gain", "id": "v2", "drive_db": 18, "curve": "tube", "bias": -0.1,
      "pre": [{ "kind": "highpass", "freq": 250 }],
      "post": [{ "kind": "lowpass", "freq": 7000 }]
    },
    {
      "type": "gain", "id": "v3", "drive_db": 12, "curve": "soft",
      "post": [{ "kind": "lowpass", "freq": 6000 }]
    },
    {
      "type": "eq", "id": "tonestack",
      "bands": [
        { "kind": "lowshelf", "freq": 120, "gain_db": 3 },
        { "kind": "peak", "freq": 600, "gain_db": -6, "q": 0.7 },
        { "kind": "highshelf", "freq": 2500, "gain_db": 2 }
      ]
    },
    { "type": "sag", "amount": 0.15, "attack_ms": 3, "release_ms": 80, "targets": ["power"] },
    {
      "type": "feedback", "amount": 0.2,
      "path": [
        { "kind": "highshelf", "freq": 3000, "gain_db": -8 },
        { "kind": "lowshelf", "freq": 100, "gain_db": -6 }
      ],
      "chain": [
        {
          "type": "eq", "id": "transformer",
          "bands": [{ "kind": "highpass", "freq": 60 }, { "kind": "lowpass", "freq": 7000 }]
        },
        { "type": "gain", "id": "power", "drive_db": 12, "curve": "soft" }
      ]
    },
    { "type": "ir", "file": "audio/fake_4x12.wav" }
  ]
}
