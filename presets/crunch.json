{
  "name": "Crunch",
  "notes": "Mid-forward classic rock crunch. One hot preamp stage, a tone stack that pushes the mids, then a power amp that does part of the clipping: lots of sag and light feedback, so it is loose and touch-sensitive.",
  "chain": [
    { "type": "eq", "bands": [{ "kind": "highpass", "freq": 90 }] },
    {
      "type": "gain", "id": "v1", "drive_db": 20, "curve": "tube", "bias": 0.15,
      "post": [{ "kind": "lowpass", "freq": 9000 }]
    },
    {
      "type": "eq", "id": "tonestack",
      "bands": [
        { "kind": "lowshelf", "freq": 200, "gain_db": -3 },
        { "kind": "peak", "freq": 800, "gain_db": 3, "q": 0.8 },
        { "kind": "highshelf", "freq": 2500, "gain_db": 2 }
      ]
    },
    { "type": "sag", "amount": 0.4, "attack_ms": 5, "release_ms": 200, "targets": ["v2"] },
    {
      "type": "feedback", "amount": 0.1,
      "path": [{ "kind": "highshelf", "freq": 3000, "gain_db": -10 }],
      "chain": [
        {
          "type": "gain", "id": "v2", "drive_db": 16, "curve": "soft",
          "post": [{ "kind": "lowpass", "freq": 7000 }]
        }
      ]
    },
    { "type": "ir", "file": "audio/fake_4x12.wav" }
  ]
}
