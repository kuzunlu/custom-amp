{
  "about": "Front panel checks. Python (tools/check_panel.py) and the plugin (PluginTest) must give exactly these errors for these panels on this chain (null = no error).",
  "chain": [
    { "type": "eq", "id": "pot", "level_db": -12, "bands": [ { "kind": "highshelf", "freq": 800, "gain_db": 8 } ] },
    { "type": "gain", "id": "v1", "drive_db": 12 },
    { "type": "split", "id": "two", "paths": [ { "chain": [ { "type": "gain", "id": "inner" } ] }, { "chain": [] } ] },
    { "type": "tonestack", "id": "tone" },
    { "type": "feedback", "id": "nfb", "amount": 0.1, "path": [ { "kind": "highshelf", "freq": 3000, "gain_db": -6 } ],
      "chain": [ { "type": "gain", "id": "pi" } ] }
  ],
  "cases": [
    { "panel": [ { "label": "Gain", "block": "pot", "setting": "level_db", "range": [-40, 0] },
                 { "block": "tone", "setting": "bass" },
                 { "label": "Presence", "block": "nfb", "setting": "path.0.gain_db", "range": [0, -12] },
                 { "block": "pot", "setting": "bands.0.freq" },
                 { "block": "two", "setting": "paths.1.level_db" },
                 { "block": "inner", "setting": "drive_db" },
                 { "block": "pi", "setting": "bias_v" } ],
      "error": null },
    { "panel": { "block": "pot" }, "error": "panel must be a list of knobs" },
    { "panel": [ {"block": "v1", "setting": "drive_db"}, {"block": "v1", "setting": "drive_db"}, {"block": "v1", "setting": "drive_db"},
                 {"block": "v1", "setting": "drive_db"}, {"block": "v1", "setting": "drive_db"}, {"block": "v1", "setting": "drive_db"},
                 {"block": "v1", "setting": "drive_db"}, {"block": "v1", "setting": "drive_db"}, {"block": "v1", "setting": "drive_db"} ],
      "error": "panel has 9 knobs; at most 8 fit" },
    { "panel": [ "pot" ], "error": "panel knob 1: must be an object with 'block' and 'setting'" },
    { "panel": [ { "block": "v1", "setting": "drive_db", "rang": [0, 1] } ],
      "error": "panel knob 1: unknown setting(s) rang. Allowed: block, label, range, setting" },
    { "panel": [ { "block": "v1" } ], "error": "panel knob 1: needs 'block' (a block id) and 'setting' (its name)" },
    { "panel": [ { "block": "v1", "setting": "drive_db", "label": 3 } ], "error": "panel knob 1: 'label' must be text" },
    { "panel": [ { "block": "v1", "setting": "drive_db", "range": [0, 0] } ],
      "error": "panel knob 1: 'range' must be two different numbers, like [-40, 0]" },
    { "panel": [ { "block": "v1", "setting": "drive_db", "range": [0, "10"] } ],
      "error": "panel knob 1: 'range' must be two different numbers, like [-40, 0]" },
    { "panel": [ { "block": "v1", "setting": "drive_db" }, { "block": "v9", "setting": "drive_db" } ],
      "error": "panel knob 2: no block has the id 'v9'" },
    { "panel": [ { "block": "v1", "setting": "curve" } ], "error": "panel knob 1: 'curve' is not a number setting of block 'v1'" },
    { "panel": [ { "block": "v1", "setting": "drive" } ], "error": "panel knob 1: 'drive' is not a number setting of block 'v1'" },
    { "panel": [ { "block": "v1", "setting": "drive_db.0" } ], "error": "panel knob 1: 'drive_db.0' is not a number setting of block 'v1'" },
    { "panel": [ { "block": "pot", "setting": "bands" } ], "error": "panel knob 1: 'bands' is not a number setting of block 'pot'" },
    { "panel": [ { "block": "pot", "setting": "bands.0.kind" } ], "error": "panel knob 1: 'bands.0.kind' is not a number setting of block 'pot'" },
    { "panel": [ { "block": "pot", "setting": "bands.1.gain_db" } ], "error": "panel knob 1: block 'pot' has no item 1 in 'bands'" },
    { "panel": [ { "block": "nfb", "setting": "path.x.gain_db" } ], "error": "panel knob 1: block 'nfb' has no item x in 'path'" },
    { "panel": [ { "block": "two", "setting": "paths.2.level_db" } ], "error": "panel knob 1: block 'two' has no item 2 in 'paths'" },
    { "panel": [ { "block": "two", "setting": "paths.0.chain" } ], "error": "panel knob 1: 'paths.0.chain' is not a number setting of block 'two'" }
  ]
}
